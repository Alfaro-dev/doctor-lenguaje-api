    "grammar_introduction": {
      "explanation": "The verb 'to be' is used to talk about names and introductions. For example, 'I am Sarah'.",
      "examples": [
        {
          "sentence": "I am John.",
          "translation": "Yo soy John."
        },
        {
          "sentence": "She is Maria.",
          "translation": "Ella es María."
        }
      ],
      "practice": [
        {
          "sentence": "I ___ (to be) Sarah.",
          "correct_answer": "am"
        },
        {
          "sentence": "He ___ (to be) a teacher.",
          "correct_answer": "is"
        }
      ]
    },
